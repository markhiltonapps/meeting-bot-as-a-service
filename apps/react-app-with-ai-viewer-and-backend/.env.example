# ---------------------------------------------------------------------------
# API (apps/react-app-with-ai-viewer-and-backend/api)
# ---------------------------------------------------------------------------

# Port
HOST=0.0.0.0
PORT=3080

DOMAIN_CLIENT=http://localhost:3080
DOMAIN_SERVER=http://localhost:3080

# MeetingBaas — https://meetingbaas.com
BASS_API_KEY=""

# OpenAI
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
OPENAI_BASE_URL="https://api.openai.com/v1"

# Notion
NOTION_API_KEY=""
DATABASE_ID=""

# Postgres
# On Railway, set this to the Postgres service reference: ${{Postgres.DATABASE_URL}}
DATABASE_URL="postgres://postgres:password@localhost:5432/project1"
# Set to "true" when connecting over a public proxy that requires TLS
# (Railway's public DATABASE_PUBLIC_URL, Render, Neon, ...).
DATABASE_SSL="false"

# ---------------------------------------------------------------------------
# Client (apps/react-app-with-ai-viewer-and-backend/client)
# ---------------------------------------------------------------------------

# Origin of the Express API. Leave empty to keep calls same-origin (the Vite dev
# proxy and the single-box deployment). Set it when the client is hosted
# separately, e.g. https://<service>.up.railway.app on Vercel.
VITE_API_BASE_URL=""

# Advanced:
# Use OpenRouter
# OPENAI_BASE_URL="https://openrouter.ai/api/v1"
